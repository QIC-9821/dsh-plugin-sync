{
  "name": "@qic-9821/dsh-plugin-sync",
  "version": "0.1.2",
  "description": "Keep the DSH plugin set (inventory, configs, enable state, package installs, local bundle binaries) in sync between two machines, with per-capability switches, schedule controls and a settings/panel UI.",
  "license": "MIT",
  "author": "QIC-9821",
  "type": "module",
  "private": false,
  "main": "./index.js",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "README.md",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "sync",
    "profile"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QIC-9821/dsh-plugin-sync.git"
  },
  "homepage": "https://github.com/QIC-9821/dsh-plugin-sync#readme",
  "bugs": {
    "url": "https://github.com/QIC-9821/dsh-plugin-sync/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
